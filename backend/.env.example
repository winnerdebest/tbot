# ============================================================
# Ani v2 — Multi-Tenant SaaS Backend (.env.example)
# ============================================================

# PostgreSQL (Neon, Railway, Render, or local Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Master Encryption & Session Secrets (generate 32+ random chars for production)
ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key-for-aes-gcm
SESSION_SECRET=change-me-to-a-32-byte-secret-key-for-sessions

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Optional Platform Default Telegram API Credentials (https://my.telegram.org)
# If blank, users can enter their own API_ID and API_HASH in the web UI.
API_ID=
API_HASH=

# Optional Fallback Groq API Key (each user provides their own in the web UI)
GROQ_API_KEY=

# Allowed Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000
